# ====================================================================
# HudhudRadar Environment Configuration Template
# Copy this file to .env and fill in real production credentials.
# NEVER commit .env to version control!
# ====================================================================

# Application Settings
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Meta Platform Credentials (Facebook & Instagram Graph API)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_PAGE_ID=your-facebook-page-id
META_PAGE_ACCESS_TOKEN=your-long-lived-page-access-token
META_INSTAGRAM_ACCOUNT_ID=your-connected-instagram-account-id
META_WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token

# AI / LLM Provider Configuration
LLM_PROVIDER=gemini  # Options: gemini, openai
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gemini-flash-latest

# Threads App (separate OAuth app for Meta Threads publishing)
THREADS_APP_ID=your-threads-app-id
THREADS_APP_SECRET=your-threads-app-secret
THREADS_REDIRECT_URI=https://your-domain.vercel.app/api/threads/oauth/callback

# Messaging & Rate Limiting Controls
MAX_MESSAGES_PER_MINUTE=20
ENFORCE_24H_WINDOW=true
REQUIRE_MANUAL_IDENTITY_CONFIRMATION=true
CONFIDENCE_THRESHOLD_AUTO_LINK=0.95
CONFIDENCE_THRESHOLD_QUEUE_REVIEW=0.60

# Cron Security (Vercel Cron / cron-job.org) — required in production
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
# Vercel Cron sends: Authorization: Bearer $CRON_SECRET automatically.
# For 5-min precision on free Vercel (Hobby allows daily cron only), use
# cron-job.org hitting GET /api/cron/scheduler-tick with that Bearer header.
CRON_SECRET=generate-a-long-random-secret
