{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "src/**",
          "docs/**",
          "database/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scheduler-tick",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/threads-token-refresh",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/instagram-token-refresh",
      "schedule": "0 5 * * *"
    }
  ]
}